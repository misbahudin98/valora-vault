DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Security: Block direct HTTP access to sensitive files
    RewriteRule ^(\.env|\.git|\.installed|composer\.(json|lock)|package\.(json|lock)|phpunit\.xml|vite\.config\.js) - [F,L,NC]

    # 2. Security: Block direct HTTP access to SQLite database & archive files
    RewriteRule \.(sqlite|sqlite3|db|zip|tar|gz|bak)$ - [F,L,NC]

    # 3. Security: Block direct HTTP access to backend & frontend private source folders
    RewriteRule ^backend/(app|bootstrap|config|database|resources|routes|storage/logs|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^frontend/(src|node_modules)(/|$) - [F,L,NC]

    # 4. Handle Authorization Header for Sanctum Bearer tokens
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 5. Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # 6. Redirect Trailing Slashes If Not A Folder
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # 7. Route everything else through root universal gateway (index.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# 8. High-Performance Gzip / Deflate Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 9. Browser Caching for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 9b. Cache Hardening: Prevent Stale Client State on Entrypoints & Manifests
<IfModule mod_headers.c>
    # Never cache HTML documents or version manifest
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </FilesMatch>
    <Files "version.json">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires 0
    </Files>

    # Strictly cache immutable fingerprinted Vite chunks forever
    <If "%{REQUEST_URI} =~ m#/_app/immutable/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
</IfModule>
