# =========================================================================
# VALORA VAULT - PRODUCTION DEPLOYMENT CONFIGURATION (.env.deploy)
# =========================================================================
# Petunjuk:
# 1. Salin berkas ini menjadi .env.deploy:
#    cp .env.deploy.example .env.deploy
# 2. Pilih salah satu model konfigurasi SSH:
#    - MODEL 1 (Paling Cepat & Ringkas): 1 Link SSH + 1 Password Universal
#    - MODEL 2 (Granular): Pemisahan semua variabel (Host, Port, User, Key, Pass)
# 3. Fitur Otomasi Lengkap:
#    - Pemisahan folder Backend (~/apps/.../backend) & Frontend (~/public_html)
#    - Konfigurasi .env otomatis (APP_URL, FRONTEND_URL, Sanctum, CORS, Session)
#    - Symbolic link otomatis (public/storage -> backend/storage/app/public)
#    - Konfigurasi gateway akses frontend (index.php & .htaccess untuk SPA & API)
# 4. Berkas .env.deploy telah masuk .gitignore sehingga aman dari commit Git.
# =========================================================================

# [UMUM & DOMAIN PRODUKSI]
DEPLOY_APP_NAME="valora-vault"
DEPLOY_APP_DOMAIN="https://example.com"
DEPLOY_APP_KEY= # Biarkan kosong untuk auto-generate atau gunakan base64:...

# =========================================================================
# MODEL 1: SINGLE LINK & 1 PASSWORD UNIVERSAL (PALING CEPAT & REKOMENDASI)
# =========================================================================
# Cukup salin tautan SSH atau perintah SSH dari dasbor hosting (Hostinger / cPanel / VPS):
# Contoh format yang didukung otomatis:
# 1. URI SSH:       ssh://u1234567@46.202.138.212:65002
# 2. CLI Command:   ssh u1234567@46.202.138.212 -p 65002
# 3. Format Ringkas: u1234567@46.202.138.212:65002
DEPLOY_SSH_URL="ssh://u1234567@46.202.138.212:65002"

# 1 Password Universal (Otomatis digunakan untuk SSH & Database jika password sama):
DEPLOY_PASSWORD="YourSecurePassword123!"

# Basis Data Target (Hostinger/cPanel MySQL):
DEPLOY_DB_CONNECTION=mysql
DEPLOY_DB_DATABASE="u1234567_valora"
DEPLOY_DB_USERNAME="u1234567_deploy"
# DEPLOY_DB_PASSWORD: Jika sama dengan DEPLOY_PASSWORD, tidak perlu diisi ulang!
# DEPLOY_DB_PASSWORD="PasswordBerbedaJikaAda"

# =========================================================================
# PEMISAHAN FOLDER BACKEND & FRONTEND (ARSITEKTUR SPLIT - OPSIONAL/KUSTOM)
# =========================================================================
# Secara default, sistem otomatis mendeteksi:
# - Backend diisolasi di luar web root : ~/apps/valora-vault/backend
# - Frontend & Gateway di web root    : ~/public_html (atau ~/domains/domain/public_html)
# - Subdomain (jika ada)              : ~/public_html/[subdomain]
# Aktifkan jika ingin menentukan direktori target secara eksplisit:
# DEPLOY_SSH_MODE="split" # 'split' (OWASP Hardened: Backend di luar webroot) atau 'standard'
# DEPLOY_SSH_BACKEND_PATH="/home/u1234567/apps/valora-vault/backend"
# DEPLOY_SSH_PUBLIC_PATH="/home/u1234567/domains/example.com/public_html"
# DEPLOY_SUBDOMAIN="" # Contoh: 'app', 'portal', 'api' jika dideploy ke subdomain

# =========================================================================
# MODEL 2: PEMISAHAN SEMUA VARIABEL (GRANULAR / EKSPLISIT)
# =========================================================================
# Aktifkan jika ingin memisahkan setiap variabel secara terpisah tanpa 1 link:
# DEPLOY_SSH_HOST="46.202.138.212"
# DEPLOY_SSH_PORT=65002
# DEPLOY_SSH_USER="u1234567"
# DEPLOY_SSH_PASS="YourSecurePassword123!"
# DEPLOY_SSH_KEY="~/.ssh/id_rsa"
#
# DEPLOY_DB_CONNECTION=mysql
# DEPLOY_DB_HOST="127.0.0.1"
# DEPLOY_DB_PORT=3306
# DEPLOY_DB_DATABASE="u1234567_valora"
# DEPLOY_DB_USERNAME="u1234567_deploy"
# DEPLOY_DB_PASSWORD="YourSecureMySQLPassword123!"

# Alternatif SQLite (jika DEPLOY_DB_CONNECTION=sqlite):
# DEPLOY_DB_DATABASE=/home/username/public_html/backend/database/database.sqlite

# =========================================================================
# [OPSI CADANGAN: FTP DEPLOYMENT (Jika SSH tidak tersedia)]
# =========================================================================
# Digunakan oleh: php deploy_ftp.php
DEPLOY_FTP_HOST="ftp.example.com"
DEPLOY_FTP_PORT=21
DEPLOY_FTP_USER="deploy@example.com"
DEPLOY_FTP_PASS="YourSecureFtpPassword123!"
DEPLOY_FTP_REMOTE_PATH="/" # Root target direktori pada server FTP
DEPLOY_FTP_USE_SSL=false # Set true untuk FTPS (Explicit TLS)
