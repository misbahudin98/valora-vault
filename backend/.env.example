APP_NAME=ValoraVault
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://valora-vault.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=valora_vault
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Host-Only cookie default (biarkan kosong agar sesi valid di localhost, 127.0.0.1, maupun domain virtual host)
SESSION_DOMAIN=

AUTH_TOKEN_TTL_MINUTES=120
AUTH_JWT_COOKIE_NAME=auth_jwt
AUTH_ROLE_COOKIE_NAME=user_role
AUTH_MAX_CONCURRENT_DEVICES=3

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@valora-vault.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://valora-vault.test
SANCTUM_STATEFUL_DOMAINS=valora-vault.test,valora-vault.test:5173,localhost,localhost:5173,127.0.0.1,127.0.0.1:5173,127.0.0.1:8000
